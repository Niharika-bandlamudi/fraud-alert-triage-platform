[{"rule_id":"RUL-001","rule_name":"Velocity spike","rule_type":"velocity_spike","description":"8 or more debits on one account within 60 minutes","parameters":"{\"window_minutes\":60,\"min_count\":8}","weight":40,"effective_from":"2026-01-01","effective_to":null,"is_active":true},{"rule_id":"RUL-002","rule_name":"New device with high spend","rule_type":"new_device","description":"First use of a device on an account (after 5 or more earlier transactions) followed by debits of 25,000 or more within 24 hours","parameters":"{\"min_prior_txns\":5,\"window_hours\":24,\"min_debit_total\":25000}","weight":45,"effective_from":"2026-01-01","effective_to":null,"is_active":true},{"rule_id":"RUL-003","rule_name":"Circular transfer","rule_type":"circular_transfer","description":"Funds return to the origin account through 3 or more hops within 72 hours","parameters":"{\"min_hops\":3,\"max_hops\":4,\"window_hours\":72}","weight":60,"effective_from":"2026-01-01","effective_to":null,"is_active":true},{"rule_id":"RUL-004","rule_name":"Dormant account reactivation","rule_type":"dormant_reactivation","description":"First transaction after 90 or more days of dormancy is a debit of 25,000 or more","parameters":"{\"dormant_days\":90,\"min_amount\":25000}","weight":50,"effective_from":"2026-01-01","effective_to":null,"is_active":true},{"rule_id":"RUL-005","rule_name":"High-value purchase","rule_type":"high_amount","description":"Single purchase of 100,000 or more (suppressed when RUL-004 already alerts the same transaction)","parameters":"{\"min_amount\":100000,\"txn_type\":\"purchase\"}","weight":25,"effective_from":"2026-01-01","effective_to":null,"is_active":true}]
